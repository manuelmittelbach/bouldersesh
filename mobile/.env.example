# Kopiere diese Datei nach `.env` und trage echte Werte ein.
# Werte findest du unter https://app.supabase.com/project/<dein-ref>/settings/api
#
# In Expo werden nur STATISCH referenzierte EXPO_PUBLIC_*-Variablen zur
# Build-Zeit eingebettet. `.env` selbst wird nie committet (siehe .gitignore).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
