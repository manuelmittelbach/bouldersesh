# Kopiere diese Datei nach `.env` und trage echte Werte ein.
# Werte findest du unter https://app.supabase.com/project/<dein-ref>/settings/api
#
# In Expo werden nur STATISCH referenzierte EXPO_PUBLIC_*-Variablen zur
# Build-Zeit eingebettet. `.env` selbst wird nie committet (siehe .gitignore).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Google-Sign-In (ADR-0016): OAuth-Client-IDs aus der Google Cloud Console
# (APIs & Services → Credentials). Die WEB-Client-ID ist Pflicht für den
# idToken (auch auf iOS/Android!); die iOS-Client-ID gehört zum Bundle
# de.manumittelbach.bouldersesh. Ohne diese Werte bleibt der Google-Button
# im Login deaktiviert (src/lib/socialAuth.ts). Zusätzlich muss die
# REVERSED iOS-Client-ID als iosUrlScheme in app.json stehen (Plugin-Eintrag
# @react-native-google-signin) — danach `npx expo prebuild` nicht vergessen.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def.apps.googleusercontent.com

# Feature-Flags (optional, Default = false). Nur STATISCH referenzierte
# EXPO_PUBLIC_FF_*-Variablen werden eingebettet — siehe src/lib/featureFlags.ts.
# EXPO_PUBLIC_FF_REALTIME_CHAT=true
# EXPO_PUBLIC_FF_GROUP_SESSIONS=true
# EXPO_PUBLIC_FF_RECURRING_SESSIONS=true
# EXPO_PUBLIC_FF_OUTDOOR_CRAGS=true
